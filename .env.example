# Copy this file to .env and fill in real values. Never commit .env.

# Langflow's own admin user (auto-login is disabled in docker-compose.yml)
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change_me

# Used by run_tests.py to call the deployed Flow over HTTP POST.
# Get the API key from Langflow -> Settings -> Langflow API Keys.
LANGFLOW_API_KEY=your_langflow_api_key_here

# Get the Flow URL from Langflow -> API (the "Run flow" code sample), e.g.
# http://localhost:7860/api/v1/run/<flow-id>
LANGFLOW_FLOW_URL=http://localhost:7860/api/v1/run/your_flow_id_here
